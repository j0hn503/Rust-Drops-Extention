{
  "name": "rust-drops-companion",
  "version": "5.32.0",
  "description": "Tracks Rust Twitch drops: claimed, live now (per streamer), unclaimed, progress",
  "scripts": {
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "format": "prettier --write \"*.js\" \"*.html\" \"*.json\"",
    "format:check": "prettier --check \"*.js\" \"*.html\" \"*.json\"",
    "test": "jest",
    "build": "node scripts/build.js",
    "validate": "npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
